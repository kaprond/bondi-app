{
  "expo": {
    "name": "LetsJam",
    "slug": "letsjam",
    "version": "3.1.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joyride.bondi",
      "buildNumber": "105",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:app.letsjamnow.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#28275F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "nl.letsjam.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "LetsJam",
      "themeColor": "#0095B6",
      "backgroundColor": "#0095B6"
    },
    "scheme": "letsjam",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "LetsJam needs your photos so you can add proof to a pool or post a clip.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "backgroundColor": "#28275F",
          "resizeMode": "contain"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#28275F"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "OpenPools",
              "displayName": "Open pools",
              "description": "Your live pools and how long until they close.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": null
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c3929136-2cf7-490a-b8d0-bb8687503ad0"
      }
    }
  }
}
